<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoffeeTrace - Vận chuyển</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <h2>CoffeeTrace</h2>
            <ul>
                <li><a href="/dashboard">Trang chủ</a></li>
                <li><a href="/transporter/info">Thông tin công ty</a></li>
                <li><a href="#" class="active">Xuất khẩu</a></li>
                <li><a href="/transporter/history">Lịch sử</a></li>
                <li><a href="#" onclick="logout()">Đăng xuất</a></li>
            </ul>
        </div>
        <div class="main-content">
            <div class="header">
                <h1>Chào mừng <%= username %>!</h1>
            </div>
            <div class="form-container active">
                <h2>Nhập liệu xuất khẩu</h2>
                <form id="transporterTransportForm">
                    <div class="form-group">
                        <label>Mã Lô *</label>
                        <input type="text" name="qrCode" placeholder="VD: CF-123" required>
                    </div>
                
                    <div class="form-group">
                        <label>Ngày xuất khẩu *</label>
                        <input type="date" name="exportDate" required>
                    </div>
                
                    <div class="form-group">
                        <label>Nguồn gốc *</label>
                        <input type="text" name="fromLocation" required>
                    </div>
                
                    <div class="form-group">
                        <label>Nước nhập khẩu *</label>
                        <input type="text" name="toLocation" required>
                    </div>
                
                    <div class="form-group">
                        <label>Phương thức vận chuyển</label>
                        <input type="text" name="transportMethod" placeholder="VD: đường thủy, hàng không,..">
                    </div>
                
                    <div class="form-group">
                        <label>Đơn vị vận chuyển</label>
                        <input type="text" name="transportCompany" placeholder="">
                    </div>
                
                    <div class="form-group">
                        <label>Số hóa đơn thương mại</label>
                        <input type="text" name="invoiceNumber" placeholder="">
                    </div>
                
                    <div class="form-group">
                        <label>Số vận đơn (B/L)</label>
                        <input type="text" name="billOfLading" placeholder="">
                    </div>
                
                    <div class="form-group">
                        <label>Chứng từ kèm theo</label>
                        <input type="text" name="attachedDocuments">
                    </div>
                
                    <div class="form-group">
                        <label>Ghi chú</label>
                        <textarea name="notes" placeholder="Mô tả thêm về quá trình xuất khẩu"></textarea>
                    </div>
                
                    <div class="form-group">
                        <label>Ảnh/Video minh họa :</label>
                        <input type="file" name="media" accept="image/*,video/*" multiple>
                    </div>
                
                    <div class="form-actions">
                        <input type="hidden" name="action" value="export" />
                        <button type="submit" class="btn">Xác nhận</button>
                    </div>
                </form>
                
            </div>
        </div>
    </div>

    <script>
        document.getElementById('transporterTransportForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            const qrCode = data.qrCode;
            const token = localStorage.getItem('token');
            const res = await fetch('/save-form-with-media', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': token },
                body: JSON.stringify({ qrCode, data, action: 'transport' })
            });
            const result = await res.json();
            alert(result.message);
        });

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('role');
            window.location.href = '/login.html';
        }
    </script>
</body>
</html>