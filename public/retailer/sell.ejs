<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoffeeTrace - Bán lẻ</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <h2>CoffeeTrace</h2>
            <ul>
                <li><a href="/dashboard">Trang chủ</a></li>
                <li><a href="/retailer/info">Thông tin cửa hàng</a></li>
                <li><a href="/retailer/receive">Nhận hàng</a></li>
                <li><a href="#" class="active">Bán lẻ</a></li>
                <li><a href="/retailer/history">Lịch sử</a></li>
                <li><a href="#" onclick="logout()">Đăng xuất</a></li>
            </ul>
        </div>
        <div class="main-content">
            <div class="header">
                <h1>Chào mừng <%= username %>!</h1>
            </div>
            <div class="form-container active">
                <h2>Nhập liệu bán lẻ</h2>
                <form id="retailerSellForm">
                    <div class="form-group"><label>Mã QR/ID *</label><input type="text" name="qrCode" placeholder="VD: CF-123" required></div>
                    <div class="form-group"><label>Ngày bán *</label><input type="date" name="date" required></div>
                    <div class="form-group"><label>Số lượng bán (bao) *</label><input type="number" name="sold" required></div>
                    <div class="form-group"><label>Giá bán (VND/bao)</label><input type="number" name="price"></div>
                    <div class="form-group"><label>Phản hồi khách hàng</label><textarea name="feedback"></textarea></div>
                    <div class="form-actions"><button type="submit" class="btn">Xác nhận</button></div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('retailerSellForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            const qrCode = data.qrCode;
            const token = localStorage.getItem('token');
            const res = await fetch('/save-lot', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': token },
                body: JSON.stringify({ qrCode, data, action: 'sell' })
            });
            const result = await res.json();
            alert(result.message);
        });

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('role');
            window.location.href = '/login.html';
        }
    </script>
</body>
</html>