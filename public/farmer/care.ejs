<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CoffeeTrace - Chăm sóc</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <div class="sidebar">
        <h2>CoffeeTrace</h2>
        <ul>
          <li><a href="/dashboard">Trang chủ</a></li>
          <li><a href="/farmer/info">Thông tin nông dân</a></li>
          <li><a href="/farmer/care" class="active">Chăm sóc</a></li>
          <li><a href="/farmer/harvest">Thu hoạch</a></li>
          <li><a href="/farmer/export">Xuất hàng</a></li>
          <li><a href="/farmer/history">Lịch sử</a></li>
          <li><a href="#" onclick="logout()">Đăng xuất</a></li>
        </ul>
      </div>
      <div class="main-content">
        <div class="header">
          <h1>Chăm sóc - <%= username %></h1>
        </div>
        <div class="card">
          <h2>Nhập thông tin chăm sóc</h2>
          <form id="careForm" enctype="multipart/form-data">
            <div class="form-group">
              <label>Mã lô:</label>
              <input type="text" name="qrCode" required />
            </div>
            <div class="form-group">
              <label>Giống cây:</label>
              <input
                type="text"
                name="coffeeVariety"
                placeholder="Ví dụ: Arabica, Robusta, Liberica..."
                required
              />
            </div>
            <div class="form-group">
              <label>Tuổi cây:</label>
              <input
                type="text"
                name="treeAge"
                placeholder=" kể từ khi trồng hoặc ghép"
                required
              />
            </div>
            <div class="form-group">
              <label>Phương pháp canh tác:</label>
              <select name="farmingMethod" id="farmingMethod" required>
                <option value="">Chọn phương pháp</option>
                <option value="hữu cơ">Hữu cơ</option>
                <option value="truyền thống">Truyền thống</option>
                <option value="bán hữu cơ">Bán hữu cơ</option>
                <option value="khác">Khác</option>
              </select>
            </div>
            <div
              class="form-group"
              id="otherFarmingMethod"
              style="display: none"
            >
              <label>Phương pháp khác (nếu chọn "Khác"):</label>
              <input
                type="text"
                name="otherFarmingMethod"
                placeholder="Nhập phương pháp canh tác khác"
              />
            </div>
            <div class="form-group">
              <label>Loại đất:</label>
              <select name="soilType">
                <option value="">Chọn loại đất</option>
                <option value="đất đỏ bazan">Đất đỏ bazan</option>
                <option value="đất sét">Đất sét</option>
                <option value="đất pha cát">Đất pha cát</option>
              </select>
            </div>
            <div class="form-group">
              <label>Loại phân bón:</label>
              <input
                type="text"
                name="fertilizerType"
                placeholder="Tên và thông tin phân bón đã sử dụng"
                required
              />
            </div>
            <div class="form-group">
              <label>Thuốc bảo vệ thực vật:</label>
              <input
                type="text"
                name="pesticide"
                placeholder="Tên thuốc trừ sâu, thuốc bảo vệ thực vật đã dùng"
                required
              />
            </div>
            <div class="form-group">
              <label>Tình trạng cây:</label>
              <select name="plantCondition" required>
                <option value="">Chọn tình trạng</option>
                <option value="tốt">Tốt</option>
                <option value="bình thường">Bình thường</option>
                <option value="kém">Kém</option>
                <option value="sâu bệnh">Có sâu bệnh</option>
              </select>
            </div>

            <div class="form-group">
              <label>Các hoạt động chăm sóc khác:</label>
              <textarea
                name="careActivities"
                placeholder="Ví dụ: tỉa cành, làm cỏ, bón phân..."
              ></textarea>
            </div>
            <div class="form-group">
              <label>Ghi chú:</label>
              <textarea
                name="notes"
                placeholder="Mô tả thêm về tình trạng hoặc hoạt động chăm sóc"
              ></textarea>
            </div>
            <div class="form-group">
              <label>Ảnh/Video minh họa:</label>
              <input
                type="file"
                name="media"
                accept="image/*,video/*"
                multiple
              />
            </div>
            <input type="hidden" name="action" value="care" />
            <button type="submit">Lưu</button>
          </form>
          <div id="formResult"></div>
        </div>
      </div>
    </div>

    <script>
      function logout() {
        fetch("/logout", { method: "POST" }).then(() => {
          window.location.href = "/login.html";
        });
      }

      // Hiển thị/ẩn trường "Phương pháp khác" dựa trên lựa chọn
      const farmingMethodSelect = document.getElementById("farmingMethod");
      const otherFarmingMethodDiv =
        document.getElementById("otherFarmingMethod");
      const otherFarmingMethodInput =
        otherFarmingMethodDiv.querySelector("input");

      farmingMethodSelect.addEventListener("change", function () {
        if (this.value === "khác") {
          otherFarmingMethodDiv.style.display = "block";
          otherFarmingMethodInput.setAttribute("required", "true");
        } else {
          otherFarmingMethodDiv.style.display = "none";
          otherFarmingMethodInput.removeAttribute("required");
        }
      });

      document
        .getElementById("careForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const formData = new FormData(e.target);

          try {
            const response = await fetch("/save-form-with-media", {
              method: "POST",
              body: formData,
              credentials: "include",
            });
            const result = await response.json();
            if (response.ok) {
              let mediaLinks = result.mediaUrls
                .map(
                  (url) => `<p><a href="${url}" target="_blank">${url}</a></p>`
                )
                .join("");
              document.getElementById("formResult").innerHTML = `
                        <p>${result.message}</p>
                        ${mediaLinks ? `<p>Media:</p>${mediaLinks}` : ""}
                    `;
            } else {
              throw new Error(result.message);
            }
          } catch (error) {
            document.getElementById(
              "formResult"
            ).innerHTML = `<p>Lỗi: ${error.message}</p>`;
          }
        });
    </script>
  </body>
</html>
