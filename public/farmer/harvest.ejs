<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoffeeTrace - Thu hoạch & Sơ chế</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .tab {
            overflow: hidden;
            border-bottom: 1px solid #ccc;
        }
        .tab button {
            background-color: inherit;
            float: left;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
        }
        .tab button:hover {
            background-color: #ddd;
        }
        .tab button.active {
            background-color: #ccc;
        }
        .tabcontent {
            display: none;
            padding: 20px;
            border: 1px solid #ccc;
            border-top: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <h2>CoffeeTrace</h2>
            <ul>
                <li><a href="/dashboard">Trang chủ</a></li>
                <li><a href="/farmer/info">Thông tin nông dân</a></li>
                <li><a href="/farmer/care">Chăm sóc</a></li>
                <li><a href="/farmer/harvest" class="active">Thu hoạch</a></li>
                <li><a href="/farmer/export">Xuất hàng</a></li>
                <li><a href="/farmer/history">Lịch sử</a></li>
                <li><a href="#" onclick="logout()">Đăng xuất</a></li>
            </ul>
        </div>
        <div class="main-content">
            <div class="header">
                <h1>Thu hoạch & Sơ chế - <%= username %></h1>
            </div>
            <div class="card">
                <div class="tab">
                    <button class="tablinks" onclick="openTab(event, 'Harvest')" id="defaultOpen">Thu hoạch</button>
                    <button class="tablinks" onclick="openTab(event, 'Processing')">Sơ chế & Bảo quản</button>
                </div>

                <!-- Form Thu hoạch -->
                <div id="Harvest" class="tabcontent">
                    <h2>Nhập thông tin thu hoạch</h2>
                    <form id="harvestForm" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Mã QR lô:</label>
                            <input type="text" name="qrCode" required>
                        </div>
                        <div class="form-group">
                            <label>Ngày thu hoạch:</label>
                            <input type="date" name="harvestDate" required>
                        </div>
                        <div class="form-group">
                            <label>Sản lượng (kg):</label>
                            <input type="number" name="yield" step="0.1" required>
                        </div>
                        <div class="form-group">
                            <label>Phương pháp thu hoạch:</label>
                            <select name="harvestMethod" required>
                                <option value="">Chọn phương pháp</option>
                                <option value="tay">Thu hoạch bằng tay</option>
                                <option value="máy">Thu hoạch bằng máy</option>
                                <option value="khác">Khác</option>
                            </select>
                        </div>
                        <div class="form-group" id="otherHarvestMethod" style="display: none;">
                            <label>Phương pháp khác (nếu chọn "Khác"):</label>
                            <input type="text" name="otherHarvestMethod" placeholder="Nhập phương pháp thu hoạch khác">
                        </div>
                        <div class="form-group">
                            <label>Chứng nhận chất lượng (nếu có):</label>
                            <input type="text" name="qualityCertification" placeholder="Ví dụ: UTZ, Rainforest Alliance...">
                        </div>
                        <div class="form-group">
                            <label>Ảnh/Video minh họa (chọn nhiều):</label>
                            <input type="file" name="media" accept="image/*,video/*" multiple>
                        </div>
                        <input type="hidden" name="action" value="harvest">
                        <button type="submit">Lưu</button>
                    </form>
                    <div id="harvestResult"></div>
                </div>

                <!-- Form Sơ chế & Bảo quản tại nông trại -->
                <div id="Processing" class="tabcontent">
                    <h2>Nhập thông tin sơ chế & bảo quản tại nông trại</h2>
                    <form id="processingForm" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Mã QR lô:</label>
                            <input type="text" name="qrCode" required>
                        </div>
                        <div class="form-group">
                            <label>Ngày bắt đầu sơ chế:</label>
                            <input type="date" name="processingStartDate" required>
                        </div>
                        <div class="form-group">
                            <label>Phương pháp sơ chế:</label>
                            <select name="processingMethod" required>
                                <option value="">Chọn phương pháp</option>
                                <option value="phơi khô tự nhiên">Phơi khô tự nhiên</option>
                                <option value="lên men ướt">Lên men ướt</option>
                                <option value="rửa sạch">Rửa sạch và phơi</option>
                                <option value="khác">Khác</option>
                            </select>
                        </div>
                        <div class="form-group" id="otherProcessingMethod" style="display: none;">
                            <label>Phương pháp khác (nếu chọn "Khác"):</label>
                            <input type="text" name="otherProcessingMethod" placeholder="Nhập phương pháp sơ chế khác">
                        </div>
                        <div class="form-group">
                            <label>Thời gian sơ chế (ngày):</label>
                            <input type="number" name="processingDuration" placeholder="Ví dụ: 3">
                        </div>
                        <div class="form-group">
                            <label>Địa điểm phơi/lên men:</label>
                            <input type="text" name="processingLocation" placeholder="Ví dụ: sân phơi, bể lên men...">
                        </div>
                        <div class="form-group">
                            <label>Thời tiết trong quá trình sơ chế:</label>
                            <select name="weatherDuringProcessing">
                                <option value="">Chọn thời tiết</option>
                                <option value="nắng">Nắng</option>
                                <option value="mưa">Mưa</option>
                                <option value="mây">Mây</option>
                                <option value="gió">Gió</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Địa điểm bảo quản tạm thời:</label>
                            <input type="text" name="tempStorageLocation" placeholder="Ví dụ: kho, bao tải...">
                        </div>
                        <div class="form-group">
                            <label>Thời gian bảo quản tạm thời (ngày):</label>
                            <input type="number" name="tempStorageDuration" placeholder="Ví dụ: 5">
                        </div>
                        <div class="form-group">
                            <label>Chứng nhận chất lượng (nếu có):</label>
                            <input type="text" name="qualityCertification" placeholder="Ví dụ: UTZ, Rainforest Alliance...">
                        </div>
                        <div class="form-group">
                            <label>Ghi chú:</label>
                            <textarea name="notes" placeholder="Mô tả thêm về sơ chế hoặc bảo quản tại nông trại"></textarea>
                        </div>
                        <div class="form-group">
                            <label>Ảnh/Video minh họa (chọn nhiều):</label>
                            <input type="file" name="media" accept="image/*,video/*" multiple>
                        </div>
                        <input type="hidden" name="action" value="processing">
                        <button type="submit">Lưu</button>
                    </form>
                    <div id="processingResult"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function logout() {
            fetch('/logout', { method: 'POST' })
                .then(() => {
                    window.location.href = '/login.html';
                });
        }

        // Tab switching
        function openTab(evt, tabName) {
            var i, tabcontent, tablinks;
            tabcontent = document.getElementsByClassName("tabcontent");
            for (i = 0; i < tabcontent.length; i++) {
                tabcontent[i].style.display = "none";
            }
            tablinks = document.getElementsByClassName("tablinks");
            for (i = 0; i < tablinks.length; i++) {
                tablinks[i].className = tablinks[i].className.replace(" active", "");
            }
            document.getElementById(tabName).style.display = "block";
            evt.currentTarget.className += " active";
        }

        // Open default tab
        document.getElementById("defaultOpen").click();

        // Handle "Khác" option for Harvest Method
        const harvestMethodSelect = document.getElementById('harvestForm').querySelector('select[name="harvestMethod"]');
        const otherHarvestMethodDiv = document.getElementById('otherHarvestMethod');
        const otherHarvestMethodInput = otherHarvestMethodDiv.querySelector('input');
        harvestMethodSelect.addEventListener('change', function() {
            if (this.value === 'khác') {
                otherHarvestMethodDiv.style.display = 'block';
                otherHarvestMethodInput.setAttribute('required', 'true');
            } else {
                otherHarvestMethodDiv.style.display = 'none';
                otherHarvestMethodInput.removeAttribute('required');
            }
        });

        // Handle "Khác" option for Processing Method
        const processingMethodSelect = document.getElementById('processingForm').querySelector('select[name="processingMethod"]');
        const otherProcessingMethodDiv = document.getElementById('otherProcessingMethod');
        const otherProcessingMethodInput = otherProcessingMethodDiv.querySelector('input');
        processingMethodSelect.addEventListener('change', function() {
            if (this.value === 'khác') {
                otherProcessingMethodDiv.style.display = 'block';
                otherProcessingMethodInput.setAttribute('required', 'true');
            } else {
                otherProcessingMethodDiv.style.display = 'none';
                otherProcessingMethodInput.removeAttribute('required');
            }
        });

        // Submit handler for Harvest Form
        document.getElementById('harvestForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            try {
                const response = await fetch('/save-form-with-media', {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                });
                const result = await response.json();
                if (response.ok) {
                    let mediaLinks = result.mediaUrls.map(url => `<p><a href="${url}" target="_blank">${url}</a></p>`).join('');
                    document.getElementById('harvestResult').innerHTML = `
                        <p>${result.message}</p>
                        ${mediaLinks ? `<p>Media:</p>${mediaLinks}` : ''}
                    `;
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                document.getElementById('harvestResult').innerHTML = `<p>Lỗi: ${error.message}</p>`;
            }
        });

        // Submit handler for Processing Form
        document.getElementById('processingForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            try {
                const response = await fetch('/save-form-with-media', {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                });
                const result = await response.json();
                if (response.ok) {
                    let mediaLinks = result.mediaUrls.map(url => `<p><a href="${url}" target="_blank">${url}</a></p>`).join('');
                    document.getElementById('processingResult').innerHTML = `
                        <p>${result.message}</p>
                        ${mediaLinks ? `<p>Media:</p>${mediaLinks}` : ''}
                    `;
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                document.getElementById('processingResult').innerHTML = `<p>Lỗi: ${error.message}</p>`;
            }
        });
    </script>
</body>
</html>