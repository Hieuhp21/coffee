<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoffeeTrace - Lưu kho</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <h2>CoffeeTrace</h2>
            <ul>
                <li><a href="/dashboard">Trang chủ</a></li>
                <li><a href="/processor/info">Thông tin cơ sở</a></li>
                <li><a href="/processor/quality">Kiểm tra chất lượng</a></li>
                <li><a href="/processor/process">Chế biến</a></li>
                <li><a href="#" class="active">Lưu kho</a></li>
                <li><a href="/processor/history">Lịch sử</a></li>
                <li><a href="#" onclick="logout()">Đăng xuất</a></li>
            </ul>
        </div>
        <div class="main-content">
            <div class="header">
                <h1>Chào mừng <%= username %>!</h1>
            </div>
            <div class="form-container active">
                <h2>Nhập liệu lưu kho</h2>
                <form id="processorStorageForm">
                    <div class="form-group"><label>Mã QR/ID *</label><input type="text" name="qrCode" placeholder="VD: CF-123" required></div>
                    <div class="form-group"><label>Ngày nhập kho *</label><input type="date" name="date" required></div>
                    <div class="form-group"><label>Vị trí kho *</label><input type="text" name="location" placeholder="VD: Kho A1" required></div>
                    <div class="form-group"><label>Điều kiện bảo quản *</label><input type="text" name="condition" placeholder="VD: Nhiệt độ 25°C, độ ẩm 60%" required></div>
                    <div class="form-actions"><button type="submit" class="btn">Xác nhận</button></div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('processorStorageForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData);
            const qrCode = data.qrCode;
            const token = localStorage.getItem('token');
            const res = await fetch('/save-lot', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': token },
                body: JSON.stringify({ qrCode, data, action: 'storage' })
            });
            const result = await res.json();
            alert(result.message);
        });

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('role');
            window.location.href = '/login.html';
        }
    </script>
</body>
</html>