<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoffeeTrace - Chế biến</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <h2>CoffeeTrace</h2>
            <ul>
                <li><a href="/dashboard">Trang chủ</a></li>
                <li><a href="/processor/info">Thông tin cơ sở</a></li>
                <li><a href="/processor/quality">Kiểm tra chất lượng</a></li>
                <li><a href="#" class="active">Chế biến</a></li>
                <li><a href="/processor/storage">Lưu kho</a></li>
                <li><a href="/processor/history">Lịch sử</a></li>
                <li><a href="#" onclick="logout()">Đăng xuất</a></li>
            </ul>
        </div>
        <div class="main-content">
            <div class="header">
                <h1>Chào mừng <%= username %>!</h1>
            </div>
            <div class="form-container active">
                <h2>Nhập liệu chế biến</h2>
                <form id="processorProcessForm" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>Mã QR/ID *</label>
                        <input type="text" name="qrCode" placeholder="VD: CF-123" required>
                    </div>
                    
                    <div class="form-group">
                        <label>Ngày nhận *</label>
                        <input type="date" name="dateReceived" required>
                    </div>
                    <div class="form-group">
                        <label>Khối lượng nhận (kg) *</label>
                        <input type="number" name="weightIn" step="0.1" required>
                    </div>
                    <div class="form-group">
                        <label>Phương pháp chế biến *</label>
                        <select name="method" required>
                            <option value="">Chọn phương pháp</option>
                            <option value="uot">Ướt</option>
                            <option value="kho">Khô</option>
                            <option value="honey">Honey</option>
                            <option value="khac">Khác</option>
                        </select>
                    </div>
                    <div class="form-group" id="otherMethod" style="display: none;">
                        <label>Phương pháp khác (nếu chọn "Khác"):</label>
                        <input type="text" name="otherMethod" placeholder="Nhập phương pháp chế biến khác">
                    </div>
                    <div class="form-group">
                        <label>Máy móc sử dụng</label>
                        <input type="text" name="machinery" placeholder="VD: Máy xay vỏ, máy sấy...">
                    </div>
                    <div class="form-group">
                        <label>Thời gian chế biến (giờ)</label>
                        <input type="number" name="processingTime" step="0.1" placeholder="VD: 48">
                    </div>
                    <div class="form-group">
                        <label>Nhiệt độ chế biến (°C)</label>
                        <input type="number" name="processingTemperature" step="0.1" placeholder="VD: 50">
                    </div>
                    <div class="form-group">
                        <label>Ngày hoàn thành *</label>
                        <input type="date" name="dateCompleted" required>
                    </div>
                    <div class="form-group">
                        <label>Khối lượng sau chế biến (kg) *</label>
                        <input type="number" name="weightOut" step="0.1" required>
                    </div>
                    <div class="form-group">
                        <label>Tỷ lệ hao hụt (%)</label>
                        <input type="number" name="lossRate" step="0.1" min="0" max="100" placeholder="VD: 5.0">
                    </div>
                    <div class="form-group">
                        <label>Chất lượng sau chế biến</label>
                        <select name="qualityAfterProcessing">
                            <option value="">Chọn chất lượng</option>
                            <option value="cao">Cao</option>
                            <option value="trung binh">Trung bình</option>
                            <option value="thap">Thấp</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Chứng nhận chất lượng (nếu có)</label>
                        <input type="text" name="qualityCertification" placeholder="VD: UTZ, Rainforest Alliance...">
                    </div>
                    <div class="form-group">
                        <label>Ghi chú</label>
                        <textarea name="notes" placeholder="Mô tả thêm về quá trình chế biến"></textarea>
                    </div>
                    <div class="form-group">
                        <label>Ảnh/Video minh họa (chọn nhiều):</label>
                        <input type="file" name="media" accept="image/*,video/*" multiple>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn">Xác nhận</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        // Handle "Khác" option for Processing Method
        const methodSelect = document.querySelector('select[name="method"]');
        const otherMethodDiv = document.getElementById('otherMethod');
        const otherMethodInput = otherMethodDiv.querySelector('input');
        methodSelect.addEventListener('change', function() {
            if (this.value === 'khac') {
                otherMethodDiv.style.display = 'block';
                otherMethodInput.setAttribute('required', 'true');
            } else {
                otherMethodDiv.style.display = 'none';
                otherMethodInput.removeAttribute('required');
            }
        });

        document.getElementById('processorProcessForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const qrCode = formData.get('qrCode');
            const token = localStorage.getItem('token');
            const res = await fetch('/save-form-with-media', {
                method: 'POST',
                headers: { 'Authorization': token }, // Remove 'Content-Type' for FormData
                body: formData // Send FormData directly
            });
            const result = await res.json();
            alert(result.message);
        });

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('role');
            window.location.href = '/login.html';
        }
    </script>
</body>
</html>